{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "${workspaceFolder}/*.cpp",
        "-o",
        "${workspaceFolder}/build/main",
        "-I",
        "Asteroids/SFML-2.6.1/include",
        "-L",
        "Asteroids/SFML-2.6.1/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
